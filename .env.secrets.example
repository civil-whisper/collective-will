# === Secrets (not committed to git) ===
# Copy to .env.secrets and fill in real values.
# On VPS, place at /opt/collective-will/<env>/.env.secrets
# Override DB_PASSWORD and WEB_ACCESS_TOKEN_SECRET per environment.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://collective:local_dev_password@localhost:5432/collective_will
DB_PASSWORD=local_dev_password

# --- LLM API keys ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Optional — leave empty if unused
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=

# --- Email (Resend — leave empty to log magic links to console) ---
RESEND_API_KEY=

# --- WhatsApp (Evolution API) ---
EVOLUTION_API_KEY=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# openssl rand -hex 32
# Must also be passed to Telegram setWebhook as secret_token
# (scripts/register-telegram-webhook.sh does this). If this is set in
# env but not registered with Telegram, all webhook requests 401.
TELEGRAM_WEBHOOK_SECRET=

# --- Voice verification ---
# Fernet key (NOT openssl rand -hex). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NEVER rotate this on a database that already holds voice data.
VOICE_ENCRYPTION_KEY=
# Modal endpoint for speaker embeddings
VOICE_EMBEDDING_ENDPOINT_URL=

# --- Witness (optional) ---
WITNESS_API_KEY=

# --- Auth token signing ---
WEB_ACCESS_TOKEN_SECRET=change-me-in-production

# --- Ops monitoring alerts ---
# Comma-separated emails to receive service alerts and daily heartbeat.
# Leave empty to disable email alerts (monitor still runs and logs).
OPS_ALERT_EMAILS=
